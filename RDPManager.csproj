<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>RDPManager</RootNamespace>
    <AssemblyName>小白服务器管理器</AssemblyName>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="work\**\*.cs" />
    <EmbeddedResource Include="favicon.ico">
      <LogicalName>RDPManager.favicon.ico</LogicalName>
    </EmbeddedResource>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <PackageReference Include="MongoDB.Driver" Version="3.11.1" />
    <EmbeddedResource Include="TerminalAssets\xterm.js" LogicalName="RDPManager.TerminalAssets.xterm.js" />
    <EmbeddedResource Include="TerminalAssets\xterm.css" LogicalName="RDPManager.TerminalAssets.xterm.css" />
    <EmbeddedResource Include="TerminalAssets\xterm-addon-fit.js" LogicalName="RDPManager.TerminalAssets.xterm-addon-fit.js" />
    <EmbeddedResource Include="TerminalAssets\xterm-LICENSE.txt" LogicalName="RDPManager.TerminalAssets.xterm-LICENSE.txt" />
    <EmbeddedResource Include="TerminalAssets\xterm-addon-fit-LICENSE.txt" LogicalName="RDPManager.TerminalAssets.xterm-addon-fit-LICENSE.txt" />
  </ItemGroup>
</Project>
